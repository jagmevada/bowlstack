// Template for include/secret.h -- copy this file, drop the .example suffix,
// and fill in real values. The real file is gitignored; this one documents the
// required keys without the values.
//
// NEVER put the Supabase service_role key here. It carries BYPASSRLS, which
// makes every row-level policy in supabase/schema.sql decorative. The device
// needs only the anon key.
//
// The database password is not needed by firmware at all -- that is for the
// SQL editor and psql, not the device.

#pragma once

// --- WiFi ------------------------------------------------------------------
// Tried in order at boot. If neither associates, the device falls back to the
// WiFiManager captive portal, so these are a convenience for known sites
// rather than a requirement. Leave as empty strings to always use the portal.
//
// THIS FILE IS COMMITTED. Real values belong in include/secret.h, which is
// gitignored -- putting them here publishes them.
#define WIFI_SSID_1 ""
#define WIFI_PASS_1 ""
#define WIFI_SSID_2 ""
#define WIFI_PASS_2 ""

// --- Supabase --------------------------------------------------------------
// Project URL, no trailing slash, e.g. "https://abcdefghijkl.supabase.co"
#define SUPABASE_URL ""

// The anon (public) key. Safe to embed only because RLS restricts it to
// INSERT/UPDATE on device_status and INSERT on status_events -- it cannot read
// anything back. See supabase/schema.sql.
#define SUPABASE_ANON_KEY ""
