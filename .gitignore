.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
CAD/*
.DS_Store

# Local Claude Code settings. Untracked deliberately: the permission allowlist
# stores the literal text of approved shell commands, so anything typed at a
# terminal -- including a credential passed to a grep -- can end up in it.
.claude/settings.json
.claude/settings.local.json

# Credentials -- never commit.
# Both spellings are listed deliberately: this file previously ignored only the
# plural, the real file was singular, and a Supabase password reached a public
# repo as a result. The wildcard covers any future variant; secret.h.example
# does not match it (it ends in .example) and is committed on purpose.
include/secret*.h

# Generated from logo512x512.png; the committed artefact is include/logo128.h
logo128.png

# GENERATED FROM include/secret.h AND HOLDS THE LIVE ANON KEY. Its own header
# has always said "Gitignored" -- nothing here actually matched it, so it was
# untracked by luck rather than by rule, and one `git add web/` would have put
# a live key in the history. That has happened in this repo once already; see
# the include/secret*.h note above. config.example.js is the committed template.
#
# It is written by tools/make_web_config.py locally, and by the Pages workflow
# from repository secrets at deploy time -- so nothing needs it in the history.
web/config.js

# Third-party, 25 MB, and reproducible from package-lock.json.
node_modules/

# Dashboard test harness. The app itself has no dependencies; jsdom is installed
# only to run web/test/smoke.mjs.
#
# The lock file is the line that earns its keep: `node_modules/` above already
# matches at any depth, but nothing matched web/test/package-lock.json, and it
# was sitting untracked in the working copy when these two branches met.
web/test/package-lock.json

# Reference material for the water-dispenser port: the 4.3B schematic PDF and
# the two handoff specs. Kept out of the repo at the owner's request -- they
# live in the working copy, not in the history, so they are NOT carried onto
# the dispenser branch either.
docs/Flowmeter kickstart/

# Supabase CLI cache (version check, link state) -- local to each machine.
supabase/.temp/

# Python bytecode (fleet_sim.py is run and compile-checked locally).
__pycache__/
*.pyc
