.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
CAD/*
.DS_Store

# Local Claude Code settings. Untracked deliberately: the permission allowlist
# stores the literal text of approved shell commands, so anything typed at a
# terminal -- including a credential passed to a grep -- can end up in it.
.claude/settings.json
.claude/settings.local.json

# Credentials -- never commit.
# Both spellings are listed deliberately: this file previously ignored only the
# plural, the real file was singular, and a Supabase password reached a public
# repo as a result. The wildcard covers any future variant; secret.h.example
# does not match it (it ends in .example) and is committed on purpose.
include/secret*.h

# Dashboard test harness. The app itself has no dependencies; jsdom is
# installed only to run web/test/smoke.mjs.
web/test/node_modules
web/test/package-lock.json

# Generated by tools/make_web_config.py from include/secret.h. Holds the live
# anon key, so it is not committed -- web/config.example.js is the template and
# the Pages workflow writes this file from repository secrets at deploy time.
web/config.js
